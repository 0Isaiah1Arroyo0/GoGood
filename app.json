{
  "expo": {
    "name": "gogood",
    "slug": "gogood",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gogood",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gogood.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F2EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.gogood.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-camera",
        {
          "cameraPermission": "Go Good needs camera access to scan barcodes and read food label expiry dates"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Go Good needs camera access to photograph food labels and read expiry dates",
          "photosPermission": "Go Good needs photo library access to use existing food photos"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Go Good uses Face ID to sign you in securely"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F3",
          "dark": {
            "backgroundColor": "#141414"
          }
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1850809f-3bec-4268-8130-0749c708d824"
      }
    },
    "owner": "arroyoi"
  }
}
